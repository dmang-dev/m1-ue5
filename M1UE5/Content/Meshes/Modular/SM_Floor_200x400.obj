# SM_Floor_200x400.obj
# Modular kit: floor/ceiling panel, rectangular — corridor fill piece
# Dimensions: 200 UU x 400 UU footprint, 10 UU thick
# Pivot: one corner at origin, panel extends in +X (200) and +Z (400), thickness in +Y
# Units: Unreal Units (1 UU = 1 cm — import at scale 1.0)
# Y-up coordinate system (standard OBJ). UE5 will convert to Z-up on import.
# Use as floor or flip 180 deg on X to use as ceiling.

# Vertices
v 0.0 0.0 0.0
v 200.0 0.0 0.0
v 200.0 10.0 0.0
v 0.0 10.0 0.0
v 0.0 0.0 400.0
v 200.0 0.0 400.0
v 200.0 10.0 400.0
v 0.0 10.0 400.0

# UV coordinates
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Vertex normals
vn 0.0 0.0 -1.0
vn 0.0 0.0 1.0
vn -1.0 0.0 0.0
vn 1.0 0.0 0.0
vn 0.0 1.0 0.0
vn 0.0 -1.0 0.0

# Faces (v/vt/vn)
# Front edge (Z=0, normal 0,0,-1)
f 1/1/1 2/2/1 3/3/1 4/4/1
# Back edge (Z=400, normal 0,0,1)
f 6/1/2 5/2/2 8/3/2 7/4/2
# Left edge (X=0, normal -1,0,0)
f 5/1/3 1/2/3 4/3/3 8/4/3
# Right edge (X=200, normal 1,0,0)
f 2/1/4 6/2/4 7/3/4 3/4/4
# Top face (Y=10, primary visible surface, normal 0,1,0)
f 4/1/5 3/2/5 7/3/5 8/4/5
# Bottom face (Y=0, normal 0,-1,0)
f 2/1/6 1/2/6 5/3/6 6/4/6
