# SM_Corner_Inner_300h.obj
# Modular kit: inner (concave) corner post
# Dimensions: 20 UU x 300 UU tall x 20 UU — matches wall thickness exactly
# Pivot: bottom corner at origin
# Units: Unreal Units (1 UU = 1 cm — import at scale 1.0)
# Y-up coordinate system (standard OBJ). UE5 will convert to Z-up on import.
#
# Placement: sits at the concave junction where two wall pieces meet at 90 deg.
# The post fills the 20x20 gap left at the inner corner of a room.
# Two exposed faces (front and left) are the visible surfaces inside the room.

# Vertices
v 0.0 0.0 0.0
v 20.0 0.0 0.0
v 20.0 300.0 0.0
v 0.0 300.0 0.0
v 0.0 0.0 20.0
v 20.0 0.0 20.0
v 20.0 300.0 20.0
v 0.0 300.0 20.0

# UV coordinates
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Vertex normals
vn 0.0 0.0 -1.0
vn 0.0 0.0 1.0
vn -1.0 0.0 0.0
vn 1.0 0.0 0.0
vn 0.0 1.0 0.0
vn 0.0 -1.0 0.0

# Faces (v/vt/vn)
# Front face (Z=0, visible inside room, normal 0,0,-1)
f 1/1/1 2/2/1 3/3/1 4/4/1
# Back face (Z=20, sits against wall, normal 0,0,1)
f 6/1/2 5/2/2 8/3/2 7/4/2
# Left face (X=0, visible inside room, normal -1,0,0)
f 5/1/3 1/2/3 4/3/3 8/4/3
# Right face (X=20, sits against wall, normal 1,0,0)
f 2/1/4 6/2/4 7/3/4 3/4/4
# Top face (Y=300, normal 0,1,0)
f 4/1/5 3/2/5 7/3/5 8/4/5
# Bottom face (Y=0, normal 0,-1,0)
f 2/1/6 1/2/6 5/3/6 6/4/6
